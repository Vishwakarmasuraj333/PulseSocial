# ==============================================================================
# PulseSocial Environment Configuration
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Database & Runtime
DATABASE_URL="postgresql://user:password@localhost:5432/pulsesocial?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/pulsesocial?schema=public"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
CRON_SECRET="your_secure_cron_worker_secret_key"

# Authentication & Security
AUTH_SECRET="your_32_character_jwt_auth_secret_key_minimum"
JWT_SECRET="your_32_character_jwt_auth_secret_key_minimum"
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Email Delivery (SMTP for 6-Digit OTP & Password Reset)
# Note: For Gmail, use an App Password with 2-Step Verification enabled
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM="PulseSocial <notifications@pulsesocial.io>"
EMAIL_FROM="PulseSocial <notifications@pulsesocial.io>"

# Google OAuth 2.0 (Sign in with Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Social Network Integrations (Only configure providers you have enabled/approved)
# Meta (Facebook & Instagram Professional)
META_CLIENT_ID=""
META_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/social/facebook/callback"
META_WEBHOOK_VERIFY_TOKEN="your_meta_webhook_verify_token"

# LinkedIn (REST Posts / UGC)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/social/linkedin/callback"

# X / Twitter (OAuth 2.0 PKCE)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/social/x/callback"

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/social/tiktok/callback"

# YouTube / Google Data API
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/social/youtube/callback"

# Pinterest
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_REDIRECT_URI="http://localhost:3000/api/social/pinterest/callback"

# Threads
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""

# Google Business Profile
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
GOOGLE_BUSINESS_REDIRECT_URI="http://localhost:3000/api/social/google-business/callback"

# AI Integrations (Google Gemini)
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

# Canva Connect
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""
CANVA_REDIRECT_URI="http://localhost:3000/api/integrations/canva/callback"

# Storage Settings (Optional S3-compatible private storage)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
